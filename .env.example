# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Database
DATABASE_URL=sqlite:///./cyberintel.db

# NVD API (optional, increases rate limit from 5 to 50 requests/30s)
# Get one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Vector Database
CHROMA_PERSIST_DIR=./data/chroma

# LLM Providers (add in Phase 5)
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=

# Supabase (add in Phase 7)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Security (add in Phase 8)
MASTER_ENCRYPTION_KEY=

# App Config
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:3000

# Optional: Allow anonymous access in development
ALLOW_ANONYMOUS=false

# Mock Authentication (development mode only)
# Used for local testing without Supabase
MOCK_AUTH_USERNAME=local@test.dev
MOCK_AUTH_PASSWORD=password123
